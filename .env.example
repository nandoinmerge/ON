# Copie este arquivo para .env e preencha os valores reais.
# Nunca coloque valores reais neste arquivo nem em nenhum arquivo versionado.

# ---------- Supabase (ambiente de teste) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Usada apenas dentro de services/, nunca exposta ao frontend
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Banco de dados ----------
# String de conexão direta, usada só por scripts administrativos e migrations
DATABASE_URL=

# ---------- Autenticação ----------
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
AUTH_MFA_ENFORCED_ROLES=owner,admin

# ---------- Storage de arquivos privados ----------
STORAGE_BUCKET_PRIVATE=agencia-arquivos-privados
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# ---------- E-mail transacional ----------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=nao-responda@ondigital.com.br

# ---------- Aplicação ----------
APP_URL=http://localhost:5173
NODE_ENV=development

# ---------- Backups ----------
BACKUP_STORAGE_PROVIDER=
BACKUP_RETENTION_DAYS=30

# ---------- Observabilidade (a partir da Fase 6) ----------
SENTRY_DSN=
